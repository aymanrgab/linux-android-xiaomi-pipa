#!/bin/sh
# Early initramfs log dump (warm restart / display debug).

_pipa_kmsg() {
	echo "initrd: pipa: $1" >/dev/kmsg 2>/dev/null || true
}

_pipa_find_persist() {
	for cand in \
		/dev/block/sda22 \
		/dev/block/by-name/persist \
		/dev/disk/by-partlabel/persist \
		/dev/block/bootdevice/by-name/persist; do
		[ -e "$cand" ] && { echo "$cand"; return 0; }
	done
	return 1
}

_pipa_dump_log() {
	tag="${1:-early}"
	dev="$(_pipa_find_persist)" || { _pipa_kmsg "persist not found ($tag)"; return 1; }

	mkdir -p /pipa-persist 2>/dev/null || return 1
	mount -t ext4 -o rw "$dev" /pipa-persist 2>/dev/null || return 1

	log=/pipa-persist/pipa-initrd.log
	{
		echo "===== pipa initrd log ($tag) ====="
		date 2>/dev/null || true
		echo "--- persist: $dev ---"
		echo "--- previous pre-reboot log present: $(test -f /pipa-persist/pipa-pre-reboot.log && echo yes || echo no) ---"
		if [ -f /pipa-persist/pipa-pre-reboot.log ]; then
			echo "--- pipa-pre-reboot.log (from last Phosh restart) ---"
			cat /pipa-persist/pipa-pre-reboot.log
			echo "--- end pre-reboot log ---"
		fi
		echo "--- /proc/cmdline ---"
		cat /proc/cmdline 2>/dev/null
		echo
		echo "--- framebuffer ---"
		for fb in /sys/class/graphics/fb*; do
			[ -d "$fb" ] || continue
			echo "  $(basename "$fb"): virtual_size=$(cat "$fb/virtual_size" 2>/dev/null) blank=$(cat "$fb/blank" 2>/dev/null)"
		done
		ls -l /dev/fb0 /dev/graphics/fb0 2>/dev/null
		echo
		echo "--- dmesg (drm/display/cont_splash/reboot) ---"
		dmesg 2>/dev/null | grep -iE 'drm|dsi|cont_splash|msm|sde|panel|reboot|restart|pipa|fb0|blank|atomic|plane|crtc|splash' || true
		echo
		echo "--- dmesg (touch/NVT) ---"
		dmesg 2>/dev/null | grep -iE 'NVT|touch|firmware|lockdown|match fw|cmdline panel' || true
		echo
		echo "--- dmesg (full) ---"
		dmesg 2>/dev/null
	} >> "$log" 2>&1
	sync
	umount /pipa-persist 2>/dev/null || true
	_pipa_kmsg "wrote $log ($tag)"
}

_pipa_kmsg "early initramfs log dump"
_pipa_dump_log "early-local-top"
