# Initramfs hooks for Xiaomi Pad 6 (pipa)

_pipa_kmsg() {
	echo "initrd: pipa: $1" >/dev/kmsg 2>/dev/null || true
}

_pipa_input_name() {
	[ -f "$1" ] || continue
	cat "$1" 2>/dev/null
}

_pipa_find_touch_event() {
	for namepath in /sys/class/input/event*/device/name; do
		[ -f "$namepath" ] || continue
		name="$(cat "$namepath" 2>/dev/null)" || continue
		case "$name" in
		NVTCapacitiveTouchScreen|NVT-ts|nt36xxx-key-helper)
			evname="$(basename "$(dirname "$(dirname "$namepath")")")"
			if [ -c "/dev/input/$evname" ]; then
				echo "/dev/input/$evname $name"
				return 0
			fi
			;;
		esac
	done
	return 1
}

_pipa_wait_for_touch_event() {
	max_wait="${1:-300}"
	i=0

	while [ "$i" -lt "$max_wait" ]; do
		if touch="$(_pipa_find_touch_event)"; then
			echo "$touch"
			return 0
		fi
		sleep 0.1
		i=$((i + 1))
	done

	return 1
}

_pipa_wait_for_nvt_ready() {
	max_wait="${1:-300}"
	i=0

	while [ "$i" -lt "$max_wait" ]; do
		if dmesg 2>/dev/null | grep -q 'boot firmware ready, touch active'; then
			return 0
		fi
		if _pipa_find_touch_event >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.1
		i=$((i + 1))
	done

	return 1
}

_pipa_wake_display() {
	for blank in /sys/class/graphics/fb*/blank; do
		[ -w "$blank" ] || continue
		echo 0 > "$blank" 2>/dev/null || true
	done

	if [ -e /dev/graphics/fb0 ] && [ ! -e /dev/fb0 ]; then
		ln -sf /dev/graphics/fb0 /dev/fb0 2>/dev/null || true
	fi

	if [ -w /dev/fb0 ]; then
		# Best-effort unblank for fbdev/unl0kr; ignore if unsupported.
		true
	fi
}

_pipa_ensure_input_nodes() {
	mkdir -p /dev/input /dev/graphics 2>/dev/null || true

	if command -v udevadm >/dev/null 2>&1; then
		udevadm trigger --subsystem-match=input --action=add 2>/dev/null || true
		udevadm settle --timeout=5 2>/dev/null || true
	fi

	for ev in /dev/input/event*; do
		[ -c "$ev" ] || continue
		chmod 666 "$ev" 2>/dev/null || true
	done
}

halium_hook_setup_touchscreen() {
	_pipa_kmsg "preparing touchscreen for unl0kr"

	_pipa_wake_display
	_pipa_ensure_input_nodes

	if _pipa_wait_for_nvt_ready 300; then
		_pipa_kmsg "NT36532 boot firmware / touch ready"
	else
		_pipa_kmsg "NT36532 wait timed out, continuing"
	fi

	if touch="$(_pipa_wait_for_touch_event 300)"; then
		_pipa_kmsg "touch event ready: $touch"
		_pipa_ensure_input_nodes
	else
		_pipa_kmsg "touch event node missing; listing input devices:"
		for namepath in /sys/class/input/event*/device/name; do
			[ -f "$namepath" ] || continue
			_pipa_kmsg "  $(basename "$(dirname "$(dirname "$namepath")")"): $(cat "$namepath" 2>/dev/null)"
		done
	fi
}

halium_hook_teardown_touchscreen() {
	:
}
