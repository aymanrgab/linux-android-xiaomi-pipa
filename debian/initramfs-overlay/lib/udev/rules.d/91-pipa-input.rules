# Xiaomi Pad 6: ignore pen for libinput; tag key-helper as keyboard fallback.
ACTION=="add", KERNEL=="event[0-9]*", SUBSYSTEM=="input", ATTRS{name}=="NVTCapacitivePen", ENV{LIBINPUT_IGNORE_DEVICE}="1"
ACTION=="add", KERNEL=="event[0-9]*", SUBSYSTEM=="input", ATTRS{name}=="nt36xxx-key-helper", ENV{ID_INPUT}="1", ENV{ID_INPUT_KEYBOARD}="1"
